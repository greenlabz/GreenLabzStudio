# GreenLabz Backend configuration
# Copy this file to `.env` and fill in real values. The Flask
# server loads .env via python-dotenv if available.

# Google PageSpeed Insights API key — optional. Without a key
# Google allows ~25 requests/minute/IP. With a key, ~25,000/day.
# Get one at https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# Where audit leads (URL + email + scores) get POSTed as JSON.
# GreenLabz's existing lead pipeline endpoint.
AUDIT_WEBHOOK_URL=

# Per-IP rate limit for the /audit endpoint, per hour.
AUDIT_RATE_LIMIT_PER_HOUR=10

# How long an audit result is served from cache before re-fetching
# from Google. In seconds. Default 1 hour.
AUDIT_CACHE_TTL_SECONDS=3600

# Server port (defaults to 5000)
PORT=5000
